{
  "name": "customer-management-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node scripts/start-production.mjs",
    "build": "tsc",
    "test": "vitest run",
    "e2e:db:migrate": "node --env-file=../.env.e2e scripts/e2e-db.mjs migrate",
    "e2e:db:seed": "node --env-file=../.env.e2e scripts/e2e-db.mjs seed",
    "e2e:db:reset": "node --env-file=../.env.e2e scripts/e2e-db.mjs reset",
    "e2e:api:verify": "node --env-file=../.env.e2e scripts/verify-e2e-api.mjs",
    "migrate:customer-encryption": "node --import tsx scripts/encrypt-customer-data.mjs",
    "verify:customer-encryption": "node --import tsx scripts/verify-customer-encryption.mjs",
    "migrate:customers": "node --import tsx scripts/migrate-customers-from-excel.mjs",
    "verify:customer-migration": "npm run e2e:db:reset && node --env-file=../.env.e2e --import tsx scripts/verify-customer-migration.mjs",
    "backup:postgres": "node --import tsx scripts/backup-postgres.mjs",
    "verify:backup-restore": "npm run e2e:db:reset && node --env-file=../.env.e2e --import tsx scripts/verify-backup-restore.mjs",
    "maintenance": "node --import tsx scripts/maintenance-notification.mjs",
    "maintenance:verify-timing": "node --import tsx scripts/verify-maintenance-timing.mjs",
    "verify:maintenance-timing": "npm run e2e:db:reset && node --env-file=../.env.e2e --import tsx scripts/verify-maintenance-timing-acceptance.mjs",
    "verify:maintenance": "npm run e2e:db:reset && node --env-file=../.env.e2e --import tsx scripts/verify-maintenance-notifications.mjs",
    "availability:report": "node --import tsx scripts/availability-report.mjs",
    "benchmark:customers:prepare": "npm run e2e:db:reset",
    "benchmark:customers": "npm run benchmark:customers:prepare && node --env-file=../.env.e2e --import tsx scripts/customer-search-benchmark.mjs",
    "benchmark:customers:load": "npm run benchmark:customers:prepare && node --env-file=../.env.e2e --import tsx scripts/customer-search-benchmark.mjs --load"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1137.0",
    "@aws-sdk/client-sesv2": "^3.1137.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "yaml": "^2.8.1"
  }
}
