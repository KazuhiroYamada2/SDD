# Local development template only. Production values are injected from AWS Secrets Manager into the ECS task.
NODE_ENV=development

# Backend runtime port.
PORT=3000

# Required in production. Must use the postgresql:// or postgres:// protocol.
DATABASE_URL=postgresql://customer_management:change_me@localhost:5432/customer_management

# Required in production. UTF-8 value of at least 32 bytes.
JWT_SECRET=<secret-at-least-32-bytes>

# Required only in production. Path to the AWS RDS CA certificate bundle.
DATABASE_SSL_CA_PATH=/path/to/aws-rds-ca-bundle.pem

# Required in every environment. Production values are injected from AWS Secrets Manager.
CUSTOMER_ENCRYPTION_CURRENT_KEY_ID=<key-id>
CUSTOMER_ENCRYPTION_KEYS_JSON={"<key-id>":"<base64-encoded-32-byte-key>"}
