# Backend runtime port
PORT=3000

# PostgreSQL connection string. Replace the placeholders before starting the backend.
DATABASE_URL=postgresql://customer_management:change_me@localhost:5432/customer_management

# Customer encryption configuration. Inject real values from the deployment secret manager.
CUSTOMER_ENCRYPTION_CURRENT_KEY_ID=<key-id>
CUSTOMER_ENCRYPTION_KEYS_JSON={"<key-id>":"<base64-encoded-32-byte-key>"}
